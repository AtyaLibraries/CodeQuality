<Project Sdk="Atya.Build.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Atya.Governance.CodeQuality</PackageId>
    <AssemblyName>Atya.Governance.CodeQuality</AssemblyName>
    <RootNamespace>Atya.Governance.CodeQuality</RootNamespace>
    <IsPackable>true</IsPackable>
    <Authors>Arsen Asulyan</Authors>
    <Copyright>Copyright (c) 2026 Arsen Asulyan</Copyright>
    <Description>Centralized reusable StyleCop and .NET analyzer configuration for Atya repositories.</Description>
    <PackageTags>dotnet;analyzers;stylecop;codequality;roslyn;governance</PackageTags>
    <RepositoryUrl>https://github.com/AtyaLibraries/CodeQuality</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <AtyaDisableInjectedReferences>true</AtyaDisableInjectedReferences>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- MinVer derives the version from git tags (e.g. tag `v1.2.3` -> 1.2.3). -->
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="buildTransitive/Atya.Governance.CodeQuality.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/Atya.Governance.CodeQuality.globalconfig" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/stylecop.json" Pack="true" PackagePath="buildTransitive/" />
    <None Include="CODING_STYLE.md" Pack="true" PackagePath="docs/" />
    <None Include="$(PkgStyleCop_Analyzers)\analyzers\dotnet\cs\*.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" />
  </ItemGroup>

  <ItemGroup Label="Build assets">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

</Project>
